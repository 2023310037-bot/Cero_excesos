# Copia este archivo como ".env" y ajusta tus datos. El ".env" NO se sube a GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cero_excesos
# Clave para firmar las sesiones (JWT). Escribe una larga y secreta, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esta-clave
